# ──────────────────────────────────────────────────────────────
#  Shadow AI Gateway – Environment Configuration
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────
# Set your OpenAI API key to get real AI responses
# Leave blank to use mock responses (safe for demos)
OPENAI_API_KEY=

# Which model to use by default
SHADOW_DEFAULT_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────
# SQLite (default, zero config)
SHADOW_DB_URL=sqlite:///./shadow_audit.db

# For production PostgreSQL:
# SHADOW_DB_URL=postgresql://user:password@localhost:5432/shadowai

# ── Auth / Security ───────────────────────────────────────────
# CHANGE THIS to a long random string in production!
SHADOW_JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Token lifetime in hours
SHADOW_TOKEN_EXPIRE_HOURS=24

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins (* for all, use specific domains in production)
SHADOW_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000

# ── Logging ───────────────────────────────────────────────────
# Set to "true" ONLY for local debugging - logs raw prompts (security risk!)
SHADOW_LOG_RAW_PROMPTS=false

# ── Alerting ──────────────────────────────────────────────────
# Slack webhook URL for critical alerts (leave blank to disable)
SLACK_WEBHOOK_URL=

# Email alerting (leave blank to disable)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# Alert on these risk levels (comma-separated)
ALERT_ON_RISK_LEVELS=CRITICAL

# ── Rate Limiting ─────────────────────────────────────────────
SHADOW_RATE_LIMIT_MAX=50
SHADOW_RATE_LIMIT_WINDOW=60

# ── Gateway ───────────────────────────────────────────────────
SHADOW_HOST=0.0.0.0
SHADOW_PORT=8000
